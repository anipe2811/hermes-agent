OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
APP_NAME=Hermes Agent
DEBUG=false

# REQUIRED: /chat needs `Authorization: Bearer <HERMES_API_KEY>`.
# Generate one with:  openssl rand -hex 32
# If empty, /chat returns 503 (unless ALLOW_UNAUTHENTICATED=true — not recommended).
HERMES_API_KEY=
ALLOW_UNAUTHENTICATED=false

# Comma-separated CORS origins, e.g. https://app.example.com  ("*" = allow all)
ALLOWED_ORIGINS=*

# Requests per minute (0 = off): per client IP, and across all clients
RATE_LIMIT_PER_MINUTE=20
GLOBAL_RATE_LIMIT_PER_MINUTE=120

# User timezone for get_current_time
TIMEZONE=Asia/Kuala_Lumpur

# Optional: Brave Search API key (free tier) — DuckDuckGo scraping is used
# otherwise, and often gets bot-blocked from VPS IPs.
BRAVE_API_KEY=

# Optional: Cloudflare Tunnel token (docker compose --profile tunnel up -d)
TUNNEL_TOKEN=
