OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
APP_NAME=Hermes Agent
DEBUG=false

# Optional hardening (leave blank/default to keep current behaviour)
# If set, /chat requires:  Authorization: Bearer <HERMES_API_KEY>
HERMES_API_KEY=
# Comma-separated CORS origins, e.g. https://app.example.com  ("*" = allow all)
ALLOWED_ORIGINS=*
